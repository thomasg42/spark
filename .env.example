# Spark environment variables. Copy to .env.local for local development.
# NEVER commit real values. NEVER log them.
# (In the FGA-Brain vault this file is stored as env.example because the
#  vault sandbox blocks dot-env names; the deploy script publishes it as .env.example.)

# --- Browser-safe (baked into the static build) -------------------------------
# Supabase project URL and anon key. The anon key is public by design; Row Level
# Security policies are what keep each partner's private rows private.
# Leave both empty to build the self-contained DEMO MODE (no server, fake data).
SUPABASE_URL=
SUPABASE_ANON_KEY=

# GitHub Pages sub-path, e.g. /spark for https://<user>.github.io/spark/.
# Leave empty for local development.
BASE_PATH=

# --- Server-only (Supabase Edge Function secrets / seed script) ----------------
# Set Edge Function secrets with:
#   npx supabase secrets set ANTHROPIC_API_KEY=... ENCRYPTION_KEY=... ALLOWED_ORIGINS=...
# They are read only inside supabase/functions/* and scripts/seed.ts.

# Used ONLY by scripts/seed.ts to create the two test accounts. Edge Functions
# never use it: they act with the signed-in user's own token so RLS always applies.
SUPABASE_SERVICE_ROLE_KEY=

# Claude API key for the date idea generator and the monthly check-in summary.
# Without it, both features fall back to clearly labelled non-AI output.
ANTHROPIC_API_KEY=

# 32+ random bytes, base64. Master key for AES-256-GCM encryption of private
# answers, check-in answers and check-in summaries. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes existing encrypted answers unreadable. Rotating it needs a
# re-encryption migration (see ROADMAP.md).
ENCRYPTION_KEY=

# Optional: comma-separated origins allowed to call the Edge Functions, e.g.
# https://<user>.github.io,http://localhost:3000   (defaults to * when empty;
# every request still needs a valid signed-in user token).
ALLOWED_ORIGINS=

# Optional: Spark Buddy's studio voice (ElevenLabs). Without the key, Buddy talks
# with the device's own voice. Used only inside the "buddy" Edge Function, only
# for people who turned AI on, and metered per person per day.
ELEVENLABS_API_KEY=
# Defaults: voice "Jade - Upbeat and Natural" (g7LVvkPWALzPxOQbF6OE) and model
# eleven_v4 (most expressive; liveliness comes from low stability + [excited]).
BUDDY_VOICE_ID=
BUDDY_VOICE_MODEL=

# --- Later phases (not used in Phase 1) ----------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
